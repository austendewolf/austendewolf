{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "austendewolf",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev",
        "--port",
        "3100",
        "--experimental-https",
        "--experimental-https-key",
        "certificates/local-key.pem",
        "--experimental-https-cert",
        "certificates/local.pem"
      ],
      "port": 3100,
      "url": "https://local.austendewolf.com:3100"
    },
    {
      "name": "daybook-ui",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "3190", "--bind", "127.0.0.1", "--directory", "plugins/daybook/ui"],
      "port": 3190
    }
  ]
}
